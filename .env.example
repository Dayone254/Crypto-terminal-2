# ─── Application ─────────────────────────────────────────────────────────────
# Copy to .env and fill in values.

# Database
DATABASE_URL=sqlite+aiosqlite:///./tpt.db

# Coinbase public REST base URL
COINBASE_API_BASE=https://api.exchange.coinbase.com

# Scanner schedule (seconds between automatic scans, 0 = disabled)
SCAN_INTERVAL_SECONDS=300

# Timezone for display and alert delivery
DISPLAY_TZ=Africa/Nairobi

# API server
API_HOST=127.0.0.1
API_PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/tpt.jsonl

# ─── Optional / Future ────────────────────────────────────────────────────────
# Telegram bot (post-v1)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Next.js dev port (for CORS allow-list)
FRONTEND_URL=http://localhost:3000
