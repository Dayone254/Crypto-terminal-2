# ─── Application ─────────────────────────────────────────────────────────────
# Copy to .env and fill in values.

# Database — the single source of truth for the SQLite location.
# Every module (ORM, raw signals layer, alembic, strategy overrides) derives its
# path from this value. A relative path is resolved against the process CWD.
DATABASE_URL=sqlite+aiosqlite:///./tpt.db

# Coinbase public REST base URL
COINBASE_API_BASE=https://api.exchange.coinbase.com

# Scanner schedule (seconds between automatic scans, 0 = disabled)
SCAN_INTERVAL_SECONDS=300

# Timezone for display and alert delivery
DISPLAY_TZ=Africa/Nairobi

# API server
API_HOST=127.0.0.1
API_PORT=8000

# Optional shared-secret auth. When set, every /api request must send
# `X-API-Token: <value>`, and the UI reads NEXT_PUBLIC_API_TOKEN.
# Leave blank to disable (only safe while API_HOST is localhost).
API_TOKEN=

# ─── Scoring ──────────────────────────────────────────────────────────────────
# The config-driven strategy in config/strategy.yaml is the default for all
# symbols. The XGBoost model consumes options-flow inputs that only exist for
# BTC/ETH, so enabling it mis-scores every other coin. Opt in deliberately.
ENABLE_ML_SCORING=false

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/tpt.jsonl

# ─── Optional ─────────────────────────────────────────────────────────────────
# Telegram bot (configure via POST /api/v1/config/telegram, or set here)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Next.js origin allowed by CORS
FRONTEND_URL=http://localhost:3000
